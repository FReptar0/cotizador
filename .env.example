# =============================================================================
# Cotizador Tersoft — Variables de entorno
#
# Copia este archivo a `.env` para desarrollo local, y carga las mismas
# variables en Vercel (Project Settings → Environment Variables) para
# producción. NUNCA subas el `.env` al repositorio: está en .gitignore.
#
# Todas son OBLIGATORIAS salvo las marcadas como (opcional).
# =============================================================================


# --- Autenticación con Google (NextAuth) -------------------------------------
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth 2.0
#
# IMPORTANTE al cambiar de dominio: en esa misma credencial hay que agregar la
# URI de redirección autorizada del entorno nuevo, o el login truena:
#   https://TU-DOMINIO/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   ← para desarrollo local
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# URL pública del sitio. Debe coincidir EXACTAMENTE con el dominio real
# (sin barra final). Si está mal, el login redirige a la nada.
#   Local:      http://localhost:3000
#   Producción: https://tu-dominio.vercel.app  (o el dominio propio)
NEXTAUTH_URL=http://localhost:3000

# Cadena aleatoria que firma las sesiones. Genera una nueva con:
#   openssl rand -base64 32
# Al migrar de cuenta conviene rotarla: invalida las sesiones viejas.
NEXTAUTH_SECRET=


# --- Google Sheets (registro de leads) ---------------------------------------
# Cuenta de servicio: Google Cloud Console → IAM → Cuentas de servicio →
# Claves → Agregar clave → JSON. Del JSON salen client_email y private_key.
GOOGLE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com

# La llave privada va en UNA sola línea, entre comillas, con los saltos de
# línea escritos como \n literales (el código los reconvierte con .replace).
# Si al pegarla en Vercel se convierten en saltos reales, Sheets deja de
# funcionar. Es el error más común de esta migración.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ID de la hoja de cálculo: está en su URL, entre /d/ y /edit
#   https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
# La hoja debe estar COMPARTIDA como editor con el GOOGLE_CLIENT_EMAIL de arriba.
GOOGLE_SHEETS_ID=

# (opcional) Nombre de la pestaña donde se escriben los leads.
# Si se omite, el código usa "Respuestas". Si la pestaña de tu hoja se llama
# distinto y no defines esto, los leads se pierden sin error visible.
GOOGLE_SHEETS_TAB_NAME=Respuestas


# --- Gemini (redacción de las propuestas) ------------------------------------
# https://aistudio.google.com/apikey
# Ojo: consume cuota de la cuenta de Google que la emitió.
GEMINI_API_KEY=


# --- Correo saliente (Gmail SMTP) --------------------------------------------
# SMTP_PASS NO es la contraseña de la cuenta: es una "Contraseña de aplicación"
# de 16 caracteres (requiere verificación en dos pasos activa).
#   Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
#
# El envío de correo es best-effort: si estas credenciales fallan, la propuesta
# en PDF igual se descarga en el navegador. La app no se cae por esto.
SMTP_USER=
SMTP_PASS=


# --- Parámetros de negocio ---------------------------------------------------
# (opcional) Tipo de cambio para cotizar en dólares. Si se omite, usa 19.
# Se lee en el navegador, por eso lleva el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_EXCHANGE_RATE_MXN_USD=19
